  "keyFeatures": [
    "Service-worker-based web proxy via Folio (Scramjet) with JavaScript rewriting",
    "Mochi: Rust reverse proxy with multi-layer in-memory and disk caching",
    "Nuru: Rust Wisp/WebSocket proxy server for TCP/UDP tunneling",
    "Free anime streaming with HLS support and disk-cached segments",
    "Games library aggregated from multiple external sources",
    "Cloud sync for settings and bookmarks via encrypted SQLite backend",
    "Chrome extension support via Rivet (DNR, content scripts, popups)",
    "Tab cloaking (site appearance masking) with focus-aware switching",
    "WireGuard VPN routing for isolated proxy traffic",
    "Adaptive capacity management that auto-tunes concurrency based on RAM"
  ],
  "publicApiSurface": [
    "POST /api/auth/register",
